# ====================================
# HelixBridge - Environment Variables
# ====================================
# Copy this file to .env and update the values

# Preferred: Copilot token
GITHUB_COPILOT_TOKEN=your_github_token

# Alternative: PAT (if your chosen endpoint supports it)
GITHUB_TOKEN= your_github_token

# Endpoint options:
# https://models.inference.ai.azure.com
# https://models.github.ai/inference
# https://api.githubcopilot.com
API_BASE_URL=https://models.inference.ai.azure.com

# Optional request timeout in seconds
API_TIMEOUT_SECONDS=90

# Webbuilder credentials used by permalink preprocessing (runs before model conversion)
INSTANCE_ID=v2_instance_id
SITENAME="webbuilder.pfizer"

# Django Configuration
DEBUG=False
SECRET_KEY=your-super-secret-django-key-change-me-in-production

# Database Configuration (MySQL)
DB_NAME=helix_upgrade_tag_manager
DB_USER=helix_user
DB_PASSWORD=your_secure_database_password
DB_HOST=localhost
DB_PORT=3306

# Static Files Configuration
STATIC_URL=/static/
STATIC_DIR=staticfiles

# GitHub API Integration (Optional - for component extraction)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_PAGINATION_LIMIT=100

# API Configuration (for internal API calls)
BEARER_TOKEN=your_api_bearer_token
API_URL=http://localhost:8000/api/api_component/

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration
LOG_LEVEL=INFO

SITENAME="webbuilder.pfizer"
USERNAME=NTID
PASSWORD=NTID_PASSWORD
INSTANCE_ID=instance_id_value

# Path to website.json for site creation
JSONPATH=</path/to/your/website.json>

# ------------------------------------
# Helix Pages Import UI Configuration
# ------------------------------------
# Keep these scripts under site_manager (as requested by UI integration)
HELIX_CONVERTER_SCRIPT_PATH=site_manager/convert_html_to_helix_backend.py
HELIX_IMPORT_SCRIPT_PATH=site_manager/import_pages_to_helix_backend.py

# Default folder/file paths used by Pages Import screen
HELIX_CONVERTER_INPUT_FOLDER=../reference/input_site
HELIX_CONVERTER_OUTPUT_FOLDER=../generated_helix_output
HELIX_IMPORT_INPUT_FOLDER=../generated_helix_output
HELIX_COMPONENTS_CSV_PATH=../reference/helix_components_html_output.csv
HELIX_ANALYSIS_CACHE_FILE=../temp/component_analysis_cache.txt
HELIX_MANUAL_INTERVENTION_CSV=../manual_page_intervention.csv

# Conversion behavior defaults
HELIX_MODEL=gpt-4o
HELIX_TEMPERATURE=0.4
HELIX_COPY_NON_HTML=true
HELIX_SHOW_MODEL_OUTPUT=false
HELIX_SKIP_EXISTING=false
HELIX_SKIP_MODEL_ANALYSIS=false
HELIX_SKIP_PERMALINK_PREPROCESS=false
# UI-driven convert keeps Playwright headed so browser automation is visible.
HELIX_PERMALINK_HEADLESS=false

# Import behavior defaults
HELIX_IMPORT_HEADLESS=false
HELIX_INSTANCE_ID_OVERRIDE=

# Optional metadata values captured by Pages Import UI
HELIX_INPUT_SITE_URL=
HELIX_OUTPUT_SITE_URL=
# ====================================
# Development vs Production
# ====================================
# For production, make sure to:
# - Set DEBUG=False
# - Use a strong SECRET_KEY
# - Configure proper ALLOWED_HOSTS
# - Use environment-specific database credentials
# - Enable HTTPS settings